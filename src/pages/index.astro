---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const servicios = [
  { code: "01", title: "Análisis y gestión de vulnerabilidades", desc: "Escaneo de activos, validación de post-parchado y gestión del ciclo de parches para reducir tu superficie de ataque de forma continua." },
  { code: "02", title: "Respuesta a incidentes", desc: "Análisis de malware, threat hunting y contención de incidentes con informes claros de hallazgos y remediación. Experiencia a nivel nacional (CSIRT)." },
  { code: "03", title: "Implementación de SGSI / ISO 27001", desc: "Diseño de manuales, políticas y procedimientos de seguridad de la información adaptados a tu organización, alineados con ISO 27001:2022." },
  { code: "04", title: "Hardening de infraestructura", desc: "Fortalecimiento de endpoints, Windows Server y Active Directory: GPO, políticas de grupo y guías de hardening con las mejores prácticas." },
  { code: "05", title: "Gestión de accesos e identidades", desc: "Matrices de roles y privilegios, control de acceso y automatización de usuarios (LDAP, Azure AD) según las funciones reales del personal." },
  { code: "06", title: "Seguridad en cloud (Azure / AWS)", desc: "Administración de permisos, sincronización de identidades con Azure AD y aseguramiento de entornos Microsoft 365 y AWS." },
];

const proyectos = [
  { tag: "Observabilidad · Prometheus + Grafana", title: "Plataforma de monitoreo de infraestructura híbrida", desc: "Diseño e implementación end-to-end de observabilidad (Prometheus, Loki, Grafana, Alertmanager) sobre Docker/Azure. Monitoreo unificado de red local, Azure y Huawei Cloud, con alertamiento por severidad a Teams.", link: "#proyecto-monitoreo" },
  { tag: "Herramienta · Python", title: "Crawler de DarkWeb por keywords", desc: "Herramienta en Python que rastrea dominios de la DarkWeb usando palabras clave, con arquitectura modular. Desarrollada de cero en 株式会社 ARS (Japón).", link: "#" },
  { tag: "GRC · ISO 27001", title: "Manual de SGSI para laboratorio clínico", desc: "Sistema de Gestión de Seguridad de la Información adaptado a las necesidades de la organización, base para el cumplimiento normativo.", link: "#" },
  { tag: "Gestión de vulnerabilidades", title: "Plataforma de gestión de vulnerabilidades y parches", desc: "Despliegue de agentes, automatización de instalación vía scripting, configuración de SSO y plantillas de reportes para mejorar la postura de seguridad.", link: "#" },
  { tag: "IAM · Gobierno de accesos", title: "Matriz de roles y privilegios", desc: "Levantamiento de accesos por función junto a Gestión Humana, definiendo una matriz de roles para el personal y sus herramientas.", link: "#" },
];

const certs = ["Ing. en Ciberseguridad (UNICARIBE)", "ISO 27001/27002 — AENOR", "Cisco CyberOps Associate", "BootCamp U. de León (España)"];
const stack = ["Active Directory", "Windows Server", "GPO", "Azure AD", "AWS", "Microsoft 365", "FortiAnalyzer", "Linux", "PowerShell", "Bash", "Python", "ISO 27001"];
---

<Layout title="Ryuki Sasaki — Ciberseguridad & Infraestructura">
  <span id="top"></span>
  <Nav />

  <header class="hero">
    <div class="wrap">
      <p class="eyebrow">Profesional en Ciberseguridad · GRC & Infraestructura</p>
      <h1 class="hero-title">
        Protejo lo que<br />
        <span class="accent">sostiene tu operación.</span>
      </h1>
      <p class="hero-sub">
        Especialista en seguridad defensiva: gestión de vulnerabilidades, respuesta a incidentes,
        ISO 27001 y hardening de infraestructura. Ayudo a organizaciones a reducir riesgo y
        madurar su postura de seguridad.
      </p>
      <div class="hero-cta">
        <a href="#contacto" class="btn btn-solid">Trabajemos juntos</a>
        <a href="#proyectos" class="btn btn-ghost">Ver proyectos</a>
      </div>
      <div class="terminal mono" aria-hidden="true">
        <span class="t-line"><span class="t-prompt">$</span> vuln-scan --validate-patches</span>
        <span class="t-line dim">Analizando activos… postura evaluada</span>
        <span class="t-line"><span class="t-prompt">$</span> ./sgsi --report iso27001</span>
        <span class="t-line ok">✓ Informe generado · riesgos priorizados</span>
      </div>
    </div>
  </header>

  <section id="servicios" class="section">
    <div class="wrap">
      <p class="eyebrow">Qué hago</p>
      <h2 class="section-title">Servicios</h2>
      <div class="grid">
        {servicios.map((s) => (
          <article class="card">
            <span class="card-code mono">{s.code}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="proyectos" class="section alt">
    <div class="wrap">
      <p class="eyebrow">Trabajo real</p>
      <h2 class="section-title">Proyectos</h2>
      <p class="section-lead">Proyectos reales de mi trayectoria en ciberseguridad, GRC e infraestructura.</p>
      <div class="proj-grid">
        {proyectos.map((p) => (
          <a href={p.link} class="proj">
            <span class="proj-tag mono">{p.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
            <span class="proj-arrow mono">Ver detalle →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="proyecto-monitoreo" class="section">
    <div class="wrap">
      <p class="eyebrow">Caso destacado</p>
      <h2 class="section-title">Plataforma de monitoreo híbrida</h2>
      <p class="section-lead">
        Observabilidad end-to-end de infraestructura crítica distribuida en red local,
        Azure y Huawei Cloud. Diseño e implementación desde cero con stack 100% open-source.
      </p>

      <div class="case">
        <div class="case-block">
          <h4 class="case-h mono">// el reto</h4>
          <p>Infraestructura crítica en tres entornos sin monitoreo unificado. Sin visibilidad centralizada, las fallas se detectaban de forma reactiva, muchas veces con el usuario final ya afectado.</p>
        </div>
        <div class="case-block">
          <h4 class="case-h mono">// la solución</h4>
          <p>Plataforma de observabilidad sobre Docker en Ubuntu/Azure, conectada a la red local por VPN site-to-site. Tres pilares: métricas (Prometheus, +150 App Services), logs (Loki + Alloy) y visualización con alertas (Grafana).</p>
        </div>
      </div>

      <figure class="diagram">
        <img src="/proyectos/arquitectura-monitoreo.svg"
             alt="Diagrama de arquitectura: servidor central en Azure recolectando métricas y logs de red local, Azure y Huawei Cloud, con notificaciones a Teams y correo." />
        <figcaption class="mono">Arquitectura general · Prometheus · Loki · Grafana · Alertmanager</figcaption>
      </figure>

      <div class="case">
        <div class="case-block">
          <h4 class="case-h mono">// decisiones técnicas</h4>
          <p>Alertas por capas sobre App Service Plans (no una por app) para evitar fatiga; monitoreo multi-nube vía API de Azure sin agentes pesados; enrutamiento por severidad a Teams; despliegue idempotente de agentes con Python y Bash.</p>
        </div>
        <div class="case-block">
          <h4 class="case-h mono">// resultado</h4>
          <p>Monitoreo proactivo unificado con detección temprana de fallas, notificaciones en tiempo real al NOC y documentación técnica completa para operación y mantenimiento.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="sobre" class="section">
    <div class="wrap sobre">
      <div class="sobre-text">
        <p class="eyebrow">Sobre mí</p>
        <h2 class="section-title">Quién está detrás</h2>
        <p>
          Soy Ryuki Sasaki Ledesma, profesional en ciberseguridad con experiencia en entornos
          Azure, análisis de vulnerabilidades, gestión de accesos, respuesta a incidentes y
          definición de políticas de seguridad.
        </p>
        <p>
          He trabajado en el Centro Nacional de Ciberseguridad (CSIRT-RD), laboratorios clínicos,
          el sector público dominicano y un proyecto en Japón. Sólidos conocimientos en Windows
          Server, GPO y Linux, orientado a proteger infraestructuras, mitigar riesgos y madurar
          la postura de seguridad de forma continua.
        </p>
      </div>
      <div class="sobre-side">
        <div class="panel">
          <h4 class="panel-title mono">// formación & certs</h4>
          <ul class="taglist">
            {certs.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div class="panel">
          <h4 class="panel-title mono">// stack</h4>
          <div class="chips">
            {stack.map((t) => <span class="chip mono">{t}</span>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contacto" class="section alt">
    <div class="wrap contacto">
      <p class="eyebrow">Siguiente paso</p>
      <h2 class="section-title">¿Hablamos?</h2>
      <p class="section-lead">Cuéntame qué necesitas proteger. Respondo en menos de 24&nbsp;horas.</p>
      <div class="contacto-links">
        <a href="mailto:ryuki_sasaki@hotmail.es" class="clink">
          <span class="clink-label mono">Email</span>
          <span class="clink-val">ryuki_sasaki@hotmail.es</span>
        </a>
        <a href="https://www.linkedin.com/in/ryuki-sasaki-ledesma" class="clink">
          <span class="clink-label mono">LinkedIn</span>
          <span class="clink-val">Ryuki Sasaki Ledesma</span>
        </a>
        <a href="https://github.com/tu-usuario" class="clink">
          <span class="clink-label mono">GitHub</span>
          <span class="clink-val">/tu-usuario</span>
        </a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap footer-inner">
      <span class="mono">© 2026 Ryuki Sasaki Ledesma</span>
      <span class="mono dim">Construido con Astro · Asegurado con intención</span>
    </div>
  </footer>
</Layout>

<style>
  .hero { padding: 6rem 0 4rem; position: relative; }
  .hero::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 50% at 20% 0%, rgba(201, 162, 39, 0.10), transparent 70%);
    pointer-events: none;
  }
  .hero-title { font-size: clamp(2.6rem, 7vw, 4.8rem); margin: 1.2rem 0; position: relative; }
  .accent { color: var(--brass); }
  .hero-sub { font-size: 1.15rem; color: var(--paper-dim); max-width: 34rem; }
  .hero-cta { display: flex; gap: 1rem; margin: 2rem 0 3rem; flex-wrap: wrap; }
  .btn { padding: 0.8rem 1.5rem; border-radius: 2px; font-weight: 500; font-size: 0.95rem; transition: all 0.2s; display: inline-block; }
  .btn-solid { background: var(--brass); color: var(--ink); }
  .btn-solid:hover { background: var(--brass-soft); transform: translateY(-2px); }
  .btn-ghost { border: 1px solid var(--ink-3); color: var(--paper); }
  .btn-ghost:hover { border-color: var(--brass); color: var(--brass); }

  .terminal {
    background: var(--ink-2); border: 1px solid var(--line); border-radius: 6px;
    padding: 1.25rem 1.4rem; max-width: 30rem; font-size: 0.85rem;
    display: flex; flex-direction: column; gap: 0.5rem;
    box-shadow: 0 20px 50px -20px rgba(0,0,0,0.6);
  }
  .t-line { color: var(--paper); }
  .t-prompt { color: var(--brass); margin-right: 0.5rem; }
  .t-line.dim { color: var(--paper-dim); }
  .t-line.ok { color: var(--teal); }

  .section { padding: 5rem 0; }
  .section.alt { background: var(--ink-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .section-title { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0.5rem 0 0.5rem; }
  .section-lead { color: var(--paper-dim); max-width: 36rem; margin-bottom: 2.5rem; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .card { background: var(--ink-2); border: 1px solid var(--line); border-radius: 6px; padding: 1.75rem; transition: all 0.25s; }
  .section.alt .card { background: var(--ink); }
  .card:hover { border-color: var(--ink-3); transform: translateY(-3px); }
  .card-code { color: var(--brass); font-size: 0.8rem; }
  .card h3 { font-size: 1.2rem; margin: 0.75rem 0 0.5rem; }
  .card p { color: var(--paper-dim); font-size: 0.95rem; }

  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .proj { background: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 1.75rem; display: block; transition: all 0.25s; position: relative; }
  .proj:hover { border-color: var(--brass); transform: translateY(-3px); }
  .proj-tag { color: var(--teal); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .proj h3 { font-size: 1.25rem; margin: 0.6rem 0 0.5rem; }
  .proj p { color: var(--paper-dim); font-size: 0.95rem; margin-bottom: 1rem; }
  .proj-arrow { color: var(--brass); font-size: 0.85rem; }

  .sobre { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: start; }
  .sobre-text p { color: var(--paper-dim); margin-top: 1rem; }
  .sobre-side { display: flex; flex-direction: column; gap: 1rem; }
  .panel { background: var(--ink-2); border: 1px solid var(--line); border-radius: 6px; padding: 1.5rem; }
  .panel-title { color: var(--brass); font-size: 0.8rem; margin-bottom: 1rem; }
  .taglist { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .taglist li { color: var(--paper); font-size: 0.95rem; padding-left: 1rem; position: relative; }
  .taglist li::before { content: "▹"; color: var(--brass); position: absolute; left: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { background: var(--ink); border: 1px solid var(--line); border-radius: 3px; padding: 0.35rem 0.7rem; font-size: 0.78rem; color: var(--paper-dim); }

  .contacto-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .clink { background: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; transition: all 0.2s; }
  .clink:hover { border-color: var(--brass); transform: translateY(-3px); }
  .clink-label { color: var(--brass); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .clink-val { color: var(--paper); font-size: 1.05rem; }

  .footer { padding: 2.5rem 0; border-top: 1px solid var(--line); }
  .footer-inner { display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; color: var(--paper-dim); flex-wrap: wrap; gap: 0.5rem; }
  .dim { color: var(--paper-dim); opacity: 0.6; }

  .case { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .case-block { background: var(--ink-2); border: 1px solid var(--line); border-radius: 6px; padding: 1.5rem; }
  .case-h { color: var(--brass); font-size: 0.8rem; margin-bottom: 0.75rem; }
  .case-block p { color: var(--paper-dim); font-size: 0.95rem; }

  .diagram {
    margin: 2rem 0;
    background: #f5f2e8;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.75rem;
    box-shadow: 0 20px 50px -20px rgba(0,0,0,0.6);
  }
  .diagram img { width: 100%; height: auto; display: block; }
  .diagram figcaption {
    color: #5a5a52;
    font-size: 0.75rem;
    text-align: center;
    margin-top: 1rem;
  }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .case { grid-template-columns: 1fr; }
    .proj-grid { grid-template-columns: 1fr; }
    .sobre { grid-template-columns: 1fr; }
    .contacto-links { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .grid { grid-template-columns: 1fr; }
    .footer-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
